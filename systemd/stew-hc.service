# The hub's hc core (user unit): always on, started at login, its own unit so the stew
# daemon can exit when idle while the core and the agents' terminals stay up. The daemon is
# only its client (it sets HC_SESSION=stew itself). Its vias run `stew exec <id>
# --no-start -- sh -c`, so `stew` (and hc) come by name from the profile, never a store path.
# Same as nix/home-manager.nix (`services.stew`). hc's holders run as hc's own transient
# user units; hc keeps its machines across a restart of this core.
[Unit]
Description=stew hub hc core (herdr-core, session stew)
# `serve` exits 0 at once when another core of the session holds its lock (hc starts one on
# demand when this unit is down): retry every 10 s, never give up
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.nix-profile/bin/herdr-core serve
Environment=HC_SESSION=stew
Environment=PATH=%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin
Environment=GIT_TERMINAL_PROMPT=0
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
